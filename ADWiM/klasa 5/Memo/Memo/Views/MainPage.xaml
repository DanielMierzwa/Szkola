<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Memo.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Memo.Models"
    Title="Memo"
    BackgroundColor="#F5F7FB">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="MEMO historyczne"
                    FontSize="42"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="Black" />

            </VerticalStackLayout>

            <Button
                Text="{Binding EasyText}"
                Command="{Binding StartGameCommand}"
                CommandParameter="{x:Static models:DifficultyLevel.Easy}"
                FontSize="19"
                HeightRequest="85" />

            <Button
                Text="{Binding MediumText}"
                Command="{Binding StartGameCommand}"
                CommandParameter="{x:Static models:DifficultyLevel.Medium}"
                FontSize="19"
                HeightRequest="85" />

            <Button
                Text="{Binding HardText}"
                Command="{Binding StartGameCommand}"
                CommandParameter="{x:Static models:DifficultyLevel.Hard}"
                FontSize="19"
                HeightRequest="85" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
